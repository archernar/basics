    tar cf $REPOTAR ../basics; ls -l $REPOTAR
}
function PrePackage() {
         local void="0";     # Bash-Function-Args
         mkdir -p "$HOME/Alamo"
         local REPOBRANCH="https://raw.githubusercontent.com/archernar/basics/refs/heads/master"
         local REPOTAR="$HOME/Alamo/BasicsRepoTarDotGit-$(date +%Y-%m-%d-%H%M%S).tar"

         echo "Creating tar file $REPOTARGET"
         tar cvf "$REPOTAR" "$HOME/scm/basics/.git"      >/dev/null 2>&1;

}
function Package() {
         local FILE="$1";     # Bash-Function-Args
         mkdir -p "$HOME/Alamo"
         mkdir -p "$HOME/Deploy"
         local REPOBRANCH="https://raw.githubusercontent.com/archernar/basics/refs/heads/master"
         local TARGET="$HOME/Alamo/AlamoDeploy-$(date +%Y-%m-%d-%H%M%S).tar"

         if [ "1" == "0" ]; then                                                                                               
             echo "Updating tar file $TARGET with $FILE"
             tar -rvf "$TARGET" "$FILE"
         fi


         if [ "1" == "0" ]; then                                                                                               
             echo "Copying $REPOBRANCH/$FILE" to "$HOME/Deploy/$FILE"
             curl -s "$REPOBRANCH/$FILE" > "$HOME/Deploy/$FILE"
             echo "Synching date $TARGET and $HOME/Deploy/$FILE"
             touch -r "$TARGET" "$HOME/Deploy/$FILE"
         fi
         if [ "1" == "0" ]; then                                                                                               
             echo "Copying $REPOBRANCH/$FILE to $HOME/$FILE"
             curl -s "$REPOBRANCH/$FILE" > "$HOME/$FILE"
             echo "Syncing date $TARGET and $HOME/$FILE"
             touch -r "$TARGET" "$HOME/$FILE"
         fi

         echo "    $HOME/Deploy/$FILE"
}

