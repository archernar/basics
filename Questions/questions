# -----------------------------------------------------------------------------
# Function: move_matches_to_top
# Description:
#   Reads a file, finds all lines matching a given regular expression, and
#   moves them to the top. The resulting content is printed to standard
#   output, leaving the original file unchanged.
#
# Arguments:
#   $1 - The path to the input file.
#   $2 - The regular expression to match against.
#
# Usage:
#   move_matches_to_top /path/to/your/file "your_regex"
#
# Example:
#   move_matches_to_top sample.txt "^error"
# -----------------------------------------------------------------------------
move_matches_to_top() {
  # Assign arguments to descriptive local variables
  local file_path="$1"
  local regex="$2"


  # --- Input Validation ---

  # Check if a file path was provided
  if [[ -z "$file_path" ]]; then
    echo "Error: No file path provided." >&2
    return 1
  fi

  # Check if a regular expression was provided
  if [[ -z "$regex" ]]; then
    echo "Error: No regular expression provided." >&2
    return 1
  fi

  # Check if the file exists and is readable
  if [[ ! -f "$file_path" || ! -r "$file_path" ]]; then
    echo "Error: File '$file_path' not found or is not readable." >&2
    return 1
  fi

  # --- Core Logic ---

  # 1. Use grep to find and print all lines that match the regular expression.
  #    The output is sent directly to standard out.
  grep "$regex" "$file_path" > /tmp/moe

  # 2. Use grep with the -v (invert-match) option to find and print all
  #    lines that DO NOT match the regular expression. This output is
  #    appended to standard out after the matching lines.
  grep -v "$regex" "$file_path" >> /tmp/moe

  cp /tmp/moe  "$file_path"
}

# --- Example Usage ---
