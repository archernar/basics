#!/usr/bin/bash
Tmp=/tmp/$$
Tmp0=/tmp/$$_$$
Tmp1=/tmp/$$_$$_$$
Tmp2=/tmp/$$_$$_$$_$$
Tmp3=/tmp/$$_$$_$$_$$_$$
trap 'exit 0' INT HUP QUIT TERM ALRM USR1
trap 'rm -f "$Tmp" "$Tmp0" "$Tmp1" "$Tmp2" "$Tmp3"' EXIT
rm -f "$Tmp $Tmp0 $Tmp1 $Tmp2 $Tmp3"  >/dev/null 2>&1;



./questions     > ./questions.html

cp ./questions.html /var/www/html/questions.html
cp ./questions.js /var/www/html/questions.js
cp ./questions.css /var/www/html/questions.css



B=happyahab
if command -v "aws" &> /dev/null
then
    # If the exit code is 0, the command exists.
    aws --profile default s3 cp ./questions.html   s3://$B/questions.html      --acl public-read
    aws --profile default s3 cp ./questions.js     s3://$B/questions.js        --acl public-read
    aws --profile default s3 cp ./questions.css    s3://$B/questions.css       --acl public-read
    echo "https://$B.s3.us-east-1.amazonaws.com/questions.html"
else
    # If the exit code is non-zero, the command does not exist.
    echo "Error: Command 'aws' not found. Cannot execute."
fi

# ls -l /var/www/html
